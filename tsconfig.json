{
	"compilerOptions": {
		"jsx": "react-jsx",
		"lib": ["esnext", "dom"],
		"module": "ESNext",
		"moduleResolution": "node",
		"types": ["node", "vite/client"],
		"baseUrl": "src",
		"paths": {
			"@/*": ["*"],
			"@components/*": ["components/*"],
			"@pages/*": ["pages/*"],
			"@hooks/*": ["hooks/*"],
			"@modules/*": ["modules/*"],
			"@context/*": ["context/*"],
			"@types/*": ["types/*"],
			"@assets/*": ["assets/*"],
			"@layout/*": ["layout/*"],
			"@store/*": ["store/*"],
			"@features/*": ["features/*"]
		}
	}
}
